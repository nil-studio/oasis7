{
  "name": "oasis7-viewer-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "ensure:dependencies": "bash ../../scripts/viewer-dependency-preflight.sh --root ../.. --purpose all",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "test:feedback-contract": "node ./scripts/software-safe-feedback-contract.test.mjs",
    "test:frontend-structure": "node ./scripts/pixel-world-bindgen-factory.test.mjs && node ./scripts/viewer-compat-aliases.test.mjs && node ./scripts/frontend-structure-audit.mjs && node --test ./scripts/viewer-static-files.test.mjs ./scripts/browser-functional-regression.test.mjs ./scripts/viewer-performance-paint-trace.test.mjs ./scripts/world-view-density-performance.test.mjs ./scripts/scope-pending-fixture.test.mjs ./scripts/viewer-owned-cdp-input.test.mjs ./scripts/viewer-performance-dom-trace.test.mjs ./scripts/viewer-owned-cdp-observation.test.mjs ./scripts/world-view-frame-capability.test.mjs ./scripts/pixel-world-retention-statistics.test.mjs ./scripts/viewer-retention-components.test.mjs ./scripts/viewer-bounded-wire-audit.test.mjs ./scripts/viewer-retention-focus.test.mjs ./scripts/viewer-held-page.test.mjs",
    "test:pixel-world:agent:visual": "node ./scripts/pixel-world-agent-visual-smoke.mjs",
    "test:pixel-world:cjk:visual": "node ./scripts/pixel-world-cjk-visual-smoke.mjs",
    "test:pixel-world:visual": "node ./scripts/pixel-world-hotspot-visual-smoke.mjs",
    "test:pixel-world:location-frame:visual": "node ./scripts/pixel-world-location-frame-visual-smoke.mjs",
    "test:pixel-world:module-visual": "node ./scripts/pixel-world-module-visual-smoke.mjs",
    "test:pixel-world:materials:gpu": "node ./scripts/agent-browser-material-visual-test.mjs",
    "test:pixel-world:scope-pending": "node ./scripts/scope-pending-visual.mjs",
    "test:pixel-world:query-overview": "node ./scripts/query-overview-visual.mjs",
    "test:pixel-world:search-race": "node ./scripts/search-race-visual.mjs",
    "test:performance": "node ./scripts/viewer-performance-probe.mjs",
    "test:perf-harness": "vitest run software_safe_src/performance_metrics.test.js",
    "perf:viewer": "node ./scripts/viewer-performance-probe.mjs",
    "build:viewer:bundle": "vite build --config vite.software-safe.config.mjs",
    "build:viewer": "npm run build:viewer:bundle && node ./scripts/finalize-software-safe-build.mjs",
    "build:software-safe:bundle": "npm run build:viewer:bundle",
    "build:software-safe": "npm run build:viewer",
    "build:viewer:visual-test": "vite build --mode visual-test --config vite.software-safe.config.mjs && node ./scripts/finalize-software-safe-build.mjs visual-test",
    "test:browser-functional": "node ./scripts/browser-functional-regression.mjs"
  },
  "dependencies": {
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "jsdom": "^31.0.0",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0",
    "ws": "8.22.1"
  }
}
