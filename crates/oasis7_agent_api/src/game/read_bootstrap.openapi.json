{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Oasis7 signed-read Game API bootstrap",
    "version": "2",
    "description": "Implemented opt-in loopback HTTP read contract. Disabled by default. No pairing, tokens, contexts, actions or operations are available."
  },
  "x-oasis7-api-revision": 1,
  "x-oasis7-schema-revision": 5,
  "x-oasis7-limits": {
    "max_proof_header_bytes": 8192,
    "max_http_header_bytes": 16384,
    "max_json_depth": 16,
    "max_active_reads": 8,
    "max_response_bytes": 2097152
  },
  "paths": {
    "/v1/game/info": {
      "get": {
        "operationId": "getGameReadInfo",
        "security": [],
        "responses": {
          "200": {
            "description": "Current bootstrap discovery; not a claim of backend availability.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadInfo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request/proof, unsupported signed contract or historical read; not retryable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/game/openapi.json": {
      "get": {
        "operationId": "getGameReadOpenApi",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document for the implemented signed-read bootstrap.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request/proof, unsupported signed contract or historical read; not retryable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/game/worlds/{world}/agents/{agent}/observation": {
      "get": {
        "operationId": "getAgentObservation",
        "description": "Only the configured world and Agent are accessible. Current owner/delegate authorization is checked on each signed World Service read. No query parameters or request body; browser Origin is rejected. Signature codec is the existing authority::sign_read_request codec, domain /v1/world/view; JSON bytes are the transport, not the signed canonical payload.",
        "security": [
          {
            "DeviceReadProof": []
          }
        ],
        "parameters": [
          {
            "name": "world",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "agent",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified current projection; integer fields are decimal strings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadProjection"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request/proof, unsupported signed contract or historical read; not retryable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "403": {
            "description": "Actor signature, current world authority, scope or browser Origin denied; not retryable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "428": {
            "description": "Device-signed actor proof required; not retryable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "429": {
            "description": "Eight backend reads are already active; retryable after an active read completes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "503": {
            "description": "Authoritative read unavailable or untrusted; retryable except response_limit_exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/game/worlds/{world}/agents/{agent}/capabilities": {
      "get": {
        "operationId": "getAgentCapabilities",
        "description": "Only the configured world and Agent are accessible. Current owner/delegate authorization is checked on each signed World Service read. No query parameters or request body; browser Origin is rejected. Signature codec is the existing authority::sign_read_request codec, domain /v1/world/view; JSON bytes are the transport, not the signed canonical payload.",
        "security": [
          {
            "DeviceReadProof": []
          }
        ],
        "parameters": [
          {
            "name": "world",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "agent",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified current projection; integer fields are decimal strings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadProjection"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request/proof, unsupported signed contract or historical read; not retryable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "403": {
            "description": "Actor signature, current world authority, scope or browser Origin denied; not retryable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "428": {
            "description": "Device-signed actor proof required; not retryable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "429": {
            "description": "Eight backend reads are already active; retryable after an active read completes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "503": {
            "description": "Authoritative read unavailable or untrusted; retryable except response_limit_exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/game/worlds/{world}/agents/{agent}/task-control": {
      "get": {
        "operationId": "getAgentTaskControl",
        "description": "The current canonical owner or currently bound executor with a live matching delegation can read current task control metadata. Other delegated Agent reads do not grant task access. Uses the device-signed /v1/world/view proof; no query, body, browser Origin or historical read. Complete private goals and captured contexts use the separate native task lane.",
        "security": [
          {
            "DeviceReadProof": []
          }
        ],
        "parameters": [
          {
            "name": "world",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "agent",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified current projection; integer fields are decimal strings.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ReadProjection"
                    },
                    {
                      "properties": {
                        "resource": {
                          "const": "task-control"
                        },
                        "data": {
                          "$ref": "#/components/schemas/TaskControlBootstrap"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request/proof, unsupported signed contract or historical read; not retryable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "403": {
            "description": "Actor signature, current world authority, scope or browser Origin denied; not retryable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "428": {
            "description": "Device-signed actor proof required; not retryable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "429": {
            "description": "Eight backend reads are already active; retryable after an active read completes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "503": {
            "description": "Authoritative read unavailable or untrusted; retryable except response_limit_exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "404": {
            "description": "No current owner-visible task control is available; not retryable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DeviceReadProof": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Oasis7-World-Read-Proof",
        "description": "hex(UTF8 JSON SignedReadRequest<ReadWorldViewRequest>), at most 8192 ASCII bytes, exactly one header. This is a public-key signature proof, not an API token or secret key. Nested unknown fields and duplicate JSON keys are rejected. JSON nesting is bounded to 16. ReadWorldViewRequest retains the existing numeric World Service wire encoding inside this opaque header.",
        "x-oasis7-decoded-schema": {
          "$ref": "#/components/schemas/SignedReadRequest"
        },
        "x-oasis7-operation-domain": "/v1/world/view"
      }
    },
    "schemas": {
      "DecimalU64": {
        "type": "string",
        "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])",
        "maxLength": 20,
        "description": "Canonical decimal u64 string, value at most 18446744073709551615."
      },
      "WorldIdentity": {
        "type": "object",
        "properties": {
          "world_id": {
            "type": "string",
            "minLength": 1
          },
          "genesis_digest": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "world_id",
          "genesis_digest"
        ],
        "additionalProperties": false
      },
      "ExecutionBinding": {
        "type": "object",
        "properties": {
          "provider_world_id": {
            "type": "string",
            "minLength": 1
          },
          "branch_id": {
            "type": "string",
            "minLength": 1
          },
          "finality_ref": {
            "type": "string",
            "minLength": 1
          },
          "governing_manifest_ref": {
            "type": "string",
            "minLength": 1
          },
          "reorg_generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "authority_generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "permission_generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          }
        },
        "required": [
          "provider_world_id",
          "branch_id",
          "finality_ref",
          "governing_manifest_ref",
          "reorg_generation",
          "authority_generation",
          "permission_generation"
        ],
        "additionalProperties": false
      },
      "CommitRef": {
        "type": "object",
        "properties": {
          "world": {
            "$ref": "#/components/schemas/WorldIdentity"
          },
          "binding": {
            "$ref": "#/components/schemas/ExecutionBinding"
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "execution_block_hash": {
            "type": "string",
            "minLength": 1
          },
          "state_root_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "world",
          "binding",
          "position",
          "execution_block_hash",
          "state_root_ref"
        ],
        "additionalProperties": false
      },
      "ReadWorldViewRequest": {
        "type": "object",
        "properties": {
          "contract_version": {
            "type": "integer",
            "const": 1
          },
          "world": {
            "$ref": "#/components/schemas/WorldIdentity"
          },
          "scope_id": {
            "type": "string",
            "pattern": "^agent:.+$"
          },
          "min_commit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CommitRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "fixed_commit": {
            "type": "null",
            "description": "Fixed historical reads are rejected by this bootstrap."
          },
          "deadline_unix_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "contract_version",
          "world",
          "scope_id"
        ],
        "additionalProperties": false
      },
      "SignedReadRequest": {
        "type": "object",
        "properties": {
          "request": {
            "$ref": "#/components/schemas/ReadWorldViewRequest"
          },
          "subject_public_key": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "signature_hex": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{128}$"
          }
        },
        "required": [
          "request",
          "subject_public_key",
          "signature_hex"
        ],
        "additionalProperties": false
      },
      "ReadError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "retryable"
        ],
        "additionalProperties": true
      },
      "ReadProjection": {
        "type": "object",
        "properties": {
          "api_revision": {
            "type": "integer",
            "const": 1
          },
          "agent_id": {
            "type": "string",
            "minLength": 1
          },
          "logical_tick": {
            "$ref": "#/components/schemas/DecimalU64"
          },
          "world_binding": {
            "type": "object",
            "description": "Committed ProjectionVersion. Every integer is encoded as a decimal string; not a standalone finality proof."
          },
          "resource": {
            "type": "string",
            "enum": [
              "observation",
              "capabilities",
              "task-control"
            ]
          },
          "data": {
            "type": "object",
            "description": "Authorized AgentCell, CapabilityCatalogSnapshot or current task control metadata. All integer values recursively use decimal strings. This is not a full first-session observation or action schema. Private goal bodies, salts and proofs are excluded."
          }
        },
        "required": [
          "api_revision",
          "agent_id",
          "logical_tick",
          "world_binding",
          "resource",
          "data"
        ],
        "additionalProperties": true
      },
      "ReadInfo": {
        "type": "object",
        "properties": {
          "api_revision": {
            "type": "integer",
            "const": 1
          },
          "mode": {
            "type": "string",
            "const": "signed_read_bootstrap"
          },
          "supported_routes": {
            "type": "array",
            "items": {
              "enum": [
                "agent:observation",
                "agent:capabilities",
                "agent:task-control"
              ]
            }
          },
          "availability": {
            "const": "checked_against_each_authorized_world_read"
          },
          "actor_proof_header": {
            "const": "X-Oasis7-World-Read-Proof"
          },
          "actor_proof_encoding": {
            "const": "hex_json"
          },
          "operation_domain": {
            "const": "/v1/world/view"
          },
          "max_proof_header_bytes": {
            "const": 8192
          },
          "writes_available": {
            "const": false
          },
          "schema_revision": {
            "const": 5
          },
          "openapi_url": {
            "const": "/v1/game/openapi.json"
          },
          "limits": {
            "type": "object",
            "properties": {
              "max_proof_header_bytes": {
                "type": "integer",
                "const": 8192
              },
              "max_http_header_bytes": {
                "type": "integer",
                "const": 16384
              },
              "max_json_depth": {
                "type": "integer",
                "const": 16
              },
              "max_active_reads": {
                "type": "integer",
                "const": 8
              },
              "max_response_bytes": {
                "type": "integer",
                "const": 2097152
              }
            },
            "required": [
              "max_proof_header_bytes",
              "max_http_header_bytes",
              "max_json_depth",
              "max_active_reads",
              "max_response_bytes"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "api_revision",
          "mode",
          "supported_routes",
          "availability",
          "actor_proof_header",
          "actor_proof_encoding",
          "operation_domain",
          "max_proof_header_bytes",
          "writes_available",
          "schema_revision",
          "openapi_url",
          "limits"
        ],
        "additionalProperties": true
      },
      "TaskControlBootstrap": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "world_id": {
            "type": "string",
            "minLength": 1
          },
          "genesis_digest": {
            "type": "string",
            "minLength": 1
          },
          "branch_id": {
            "type": "string",
            "minLength": 1
          },
          "agent_id": {
            "type": "string",
            "minLength": 1
          },
          "owner_binding": {
            "type": "string",
            "minLength": 1
          },
          "owner_public_key": {
            "type": "string",
            "minLength": 1
          },
          "created_operation_id": {
            "type": "string",
            "minLength": 1
          },
          "reorg_epoch": {
            "$ref": "#/components/schemas/DecimalU64"
          },
          "owner_generation": {
            "$ref": "#/components/schemas/DecimalU64"
          },
          "task_revision": {
            "$ref": "#/components/schemas/DecimalU64"
          },
          "latest_goal_revision": {
            "$ref": "#/components/schemas/DecimalU64"
          },
          "active_goal_revision": {
            "$ref": "#/components/schemas/DecimalU64"
          },
          "executor_epoch": {
            "$ref": "#/components/schemas/DecimalU64"
          },
          "schema_revision": {
            "const": "1"
          },
          "task_status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ]
          },
          "executor_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "active_goal_reference": {
            "$ref": "#/components/schemas/GoalReference"
          },
          "executor_binding": {
            "$ref": "#/components/schemas/ExecutorBinding"
          }
        },
        "required": [
          "task_id",
          "world_id",
          "genesis_digest",
          "branch_id",
          "agent_id",
          "owner_binding",
          "owner_public_key",
          "created_operation_id",
          "reorg_epoch",
          "owner_generation",
          "task_revision",
          "latest_goal_revision",
          "active_goal_revision",
          "executor_epoch",
          "schema_revision",
          "task_status",
          "executor_id"
        ],
        "description": "Current canonical task control metadata for the owner or currently bound delegated executor. Binding, replacement and Stop advance the executor fence; goal publication retains the current binding. Private content, salt, proof and digest are excluded."
      },
      "GoalReference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "goal_revision": {
            "$ref": "#/components/schemas/DecimalU64",
            "pattern": "^[1-9]"
          },
          "goal_ref": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "prepare_operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "publish_operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "activation_committed_height": {
            "$ref": "#/components/schemas/DecimalU64",
            "pattern": "^[1-9]"
          }
        },
        "required": [
          "goal_revision",
          "goal_ref",
          "prepare_operation_id",
          "publish_operation_id",
          "activation_committed_height"
        ],
        "description": "Public owner-signed activation metadata. The opaque reference is a private-salt commitment; salt, complete goal and body-bound signature remain private. Committed height locates historical activation; it is not a standalone finality proof."
      },
      "ExecutorBinding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "executor_id": {
            "type": "string",
            "minLength": 1
          },
          "executor_public_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "delegation_generation": {
            "$ref": "#/components/schemas/DecimalU64",
            "pattern": "^[1-9]"
          },
          "executor_epoch": {
            "$ref": "#/components/schemas/DecimalU64",
            "pattern": "^[1-9]"
          }
        },
        "required": [
          "executor_id",
          "executor_public_key",
          "delegation_generation",
          "executor_epoch"
        ]
      }
    }
  }
}
