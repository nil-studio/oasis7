{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window has finite project, document, GitHub and local tool commands. External Codex navigation accepts identity-only thread locators; no session execution or request control.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-open-project",
    "allow-query-view",
    "allow-cancel-source-reads",
    "allow-import-sign-context",
    "allow-add-worktree-reference",
    "allow-read-github-window",
    "allow-query-daily-work",
    "allow-save-daily-work",
    "allow-query-work-projection",
    "allow-refresh-work-checks",
    "allow-search-rules",
    "allow-query-document-inventory",
    "allow-query-document-directory",
    "allow-query-document-semantic-tree",
    "allow-load-document-tree-reading",
    "allow-save-document-tree-reading",
    "allow-reset-document-tree-reading",
    "allow-load-document-tree-last-view",
    "allow-save-decision-draft",
    "allow-replace-decision",
    "allow-query-decision-history",
    "allow-save-preference",
    "allow-read-source",
    "allow-refresh-source",
    "allow-rebuild-cache",
    "allow-refresh-github",
    "allow-get-github-snapshot",
    "allow-open-source-target",
    "allow-choose-project",
    "allow-associate-work",
    "allow-read-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-context-bindings",
    "allow-context-choose-library",
    "allow-context-list",
    "allow-context-get",
