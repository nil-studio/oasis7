{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window has the finite project and experimental runtime bridge, plus lifecycle invalidation listeners. No arbitrary filesystem, shell, protocol or remote-origin access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-open-project",
    "allow-query-view",
    "allow-query-work-projection",
    "allow-refresh-work-checks",
    "allow-search-rules",
    "allow-query-document-inventory",
    "allow-query-document-directory",
    "allow-query-document-semantic-tree",
    "allow-load-document-tree-reading",
    "allow-save-document-tree-reading",
    "allow-reset-document-tree-reading",
    "allow-load-document-tree-last-view",
    "allow-save-decision-draft",
    "allow-save-preference",
    "allow-read-source",
    "allow-refresh-source",
    "allow-rebuild-cache",
    "allow-refresh-github",
    "allow-get-github-snapshot",
    "allow-open-source-target",
    "allow-choose-project",
    "allow-associate-work",
    "allow-read-version",
    "allow-get-runtime",
    "allow-reconcile-runtime-operation",
    "allow-set-runtime-enabled",
    "allow-connect-runtime",
    "allow-create-runtime-session",
    "allow-continue-runtime-session",
    "allow-start-runtime-turn",
    "allow-steer-runtime-turn",
    "allow-interrupt-runtime-turn",
    "allow-answer-runtime-request",
    "allow-get-exit-status",
    "allow-request-exit-wait",
    "allow-request-exit-stop",
    "allow-cancel-exit-wait",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-context-bindings",
    "allow-context-choose-library",
    "allow-context-list",
    "allow-context-get",
    "allow-context-save",
    "allow-context-archive",
    "allow-context-history",
    "allow-context-restore-entry",
    "allow-context-doctor",
    "allow-context-snapshot-export",
    "allow-context-snapshot-inspect",
    "allow-context-snapshot-restore",
    "allow-tool-jobs",
    "allow-tool-signer-observe",
    "allow-tool-signer-doctor",
    "allow-tool-choose-file",
    "allow-tool-file-prepare",
    "allow-tool-signer-submit",
    "allow-tool-signer-inspect",
    "allow-tool-cli-install",
    "allow-secret-stage",
    "allow-preview-private-input",
    "allow-start-private-runtime-turn",
    "allow-tool-file-verify",
    "allow-tool-file-reconcile",
    "allow-tool-file-recover",
    "allow-tool-cli-observe",
    "allow-context-info",
    "allow-context-reconcile",
    "allow-tool-cli-reconcile"
  ]
}
