{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Trusted local window: worktree and uncommitted document preview, private libraries, CLI, signer and ToolJobs. No remote page IPC or cloud personal-data writes.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-open-project",
    "allow-query-view",
    "allow-import-sign-context",
    "allow-search-rules",
    "allow-query-document-inventory",
    "allow-query-document-directory",
    "allow-query-document-semantic-tree",
    "allow-load-document-tree-reading",
    "allow-save-document-tree-reading",
    "allow-reset-document-tree-reading",
    "allow-load-document-tree-last-view",
    "allow-save-preference",
    "allow-read-source",
    "allow-refresh-source",
    "allow-rebuild-cache",
    "allow-open-source-target",
    "allow-choose-project",
    "allow-read-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-context-bindings",
    "allow-context-choose-library",
    "allow-context-list",
    "allow-context-get",
    "allow-context-save",
    "allow-context-archive",
    "allow-context-history",
    "allow-context-restore-entry",
    "allow-context-doctor",
    "allow-context-snapshot-export",
    "allow-context-snapshot-inspect",
    "allow-context-snapshot-restore",
    "allow-tool-jobs",
    "allow-tool-signer-observe",
    "allow-tool-signer-doctor",
    "allow-tool-choose-file",
    "allow-tool-file-prepare",
    "allow-tool-signer-submit",
    "allow-tool-signer-inspect",
    "allow-tool-cli-install",
    "allow-secret-stage",
    "allow-tool-file-verify",
    "allow-tool-file-reconcile",
    "allow-tool-file-recover",
    "allow-tool-cli-observe",
    "allow-context-info",
    "allow-context-reconcile",
    "allow-tool-cli-reconcile"
  ]
}
