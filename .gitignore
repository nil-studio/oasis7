# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Local demo outputs
.data/
output/

# Local runtime config
config.toml
!.codex/config.toml

# Legacy local env file (deprecated)
.env

# Local debug artifacts
.tmp/
.distfs/
__pycache__/
*.py[cod]
# Persistent task-scoped post-merge finalizer flock state.
.pm/github-project-sync/tasks.json
.pm/github-project-sync/tasks.json.task_*.finalizer-lock
# Local generated builtin wasm artifacts; tracked release truth lives in manifests/DistFS blobs.
crates/oasis7/src/runtime/world/artifacts/m1_builtin_modules/*.wasm
crates/oasis7/src/runtime/world/artifacts/m4_builtin_modules/*.wasm
crates/oasis7/src/runtime/world/artifacts/m5_builtin_modules/*.wasm
artifacts/owr4_baseline/
artifacts/robot_voxel_pipeline/
# egui_kittest snapshot artifacts
**/tests/snapshots/*.diff.png
**/tests/snapshots/*.new.png

.playwright
.playwright-cli
.cache/doc-governance/
node_modules/
crates/oasis7_viewer/.software-safe-build/
crates/oasis7_viewer/.software-safe-test-build/
crates/oasis7_viewer/.viewer-test-dist/
crates/oasis7_viewer/dist
crates/oasis7/explorer-index.json
**/.oasis7-hosted-player-sessions.json
**/.oasis7-hosted-registration-replay.json
tools/provider/oasis7_provider_workspace/.provider/
tools/provider/oasis7_provider_workspace/.openclaw/
